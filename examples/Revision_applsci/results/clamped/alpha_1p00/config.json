    "write_correlation_table": false,
    "save_snapshot_image": false,
    "save_final_image": true,
    "save_frequency_iterations": false,
    "structural_mode_check": true,
    "correlation": {
      "enabled": true,
      "metric": "mac",
      "write_csv": true,
      "best_k": 3
    }
