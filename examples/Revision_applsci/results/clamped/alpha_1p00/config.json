    "thickness": 1,
    "mesh": {
      "nelx": 400,
      "nely": 50
    },
    "load_cases": [
      {
        "name": "case1",
        "factor": 1,
        "loads": {
          "type": "semi_harmonic",
          "mode": 1,
          "factor": 1
