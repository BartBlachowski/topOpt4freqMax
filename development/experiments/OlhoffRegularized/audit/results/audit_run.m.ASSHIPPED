function audit_run(tag,bcType,nelx,nely,rmin,formulation,optimizer,maxOuter)
%AUDIT_RUN  One instrumented OlhoffRegularized run, saved for offline audit.
%   Audit-only harness.  It changes no numerical policy: every runCfg entry
%   below is the repository's regularized default for that control.
repo='/Users/piotrek/Programming/topOpt4freqMax';
addpath(fullfile(repo,'analysis','OlhoffRegularized','Matlab'));
outDir=fullfile(repo,'analysis','OlhoffRegularized','audit','results',tag);
if exist(outDir,'dir')~=7,mkdir(outDir);end

runCfg=struct('optimizer',optimizer,'formulation',formulation,'verbose',true, ...
    'tol_mult',.05,'max_outer_iterations',maxOuter,'max_inner_iterations',500, ...
    'max_trial_steps',8,'move_min',1e-7,'move_max',.005, ...
    'accept_ratio',.10,'grow_ratio',.75,'stationarity_tol',.02, ...
    'density_tol',1e-4,'objective_tol',1e-5,'persistence',20, ...
    'progress_tolerance',1e-4,'progress_window',10, ...
    'progress_spike_tolerance',3e-4,'progress_dwell',20, ...
    'progress_shrink_factor',.5);
if strcmp(bcType,'cantilever'),runCfg.tip_mass_fraction=.20;end

fprintf('=== AUDIT RUN %s : %s %dx%d rmin=%g %s/%s maxOuter=%d ===\n', ...
    tag,bcType,nelx,nely,rmin,formulation,optimizer,maxOuter);
t=tic;
[rho,omega,info]=topopt_olhoff_regularized(nelx,nely,.5,3,rmin,.005,bcType,runCfg);
wall=toc(t);

meta=struct('tag',tag,'bcType',bcType,'nelx',nelx,'nely',nely,'rmin',rmin, ...
    'formulation',formulation,'optimizer',optimizer,'maxOuter',maxOuter, ...
    'wall',wall,'matlab',version,'utc',datestr(now,31)); %#ok<TNOW1,DATST>
design=info.design; hist=info.history; status=info.status;
stop_reason=info.stop_reason; iterations=info.iterations; lambda=info.lambda;
evlog=info.log; regcfg=info.regularization; runcfg_used=info.cfg;
save(fullfile(outDir,'run.mat'),'rho','omega','design','hist','status', ...
    'stop_reason','iterations','lambda','evlog','meta','regcfg','runcfg_used','-v7.3');

% flat CSV trajectory
h=hist;K=numel(h.outerIteration);
fid=fopen(fullfile(outDir,'trajectory.csv'),'w');
fprintf(fid,['outer,omega1,omega2,omega3,N,multJ,trustUsed,trustNext,ceilUsed,ceilNext,' ...
  'trials,inner,innerConv,accepted,ratio,predicted,actual,predSlope,dxInf,dxRms,' ...
  'volume,objective,relObj,statPass,convCount,acceptedSinceContract,' ...
  'winCumProg,winMaxStep,winReady,winStatPass,ceilContracted\n']);
for k=1:K
    fprintf(fid,'%d,%.10g,%.10g,%.10g,%d,%d,%.6e,%.6e,%.6e,%.6e,%d,%d,%d,%d,%.6e,%.10e,%.10e,%.6e,%.6e,%.6e,%.10g,%.12g,%.6e,%d,%d,%d,%.6e,%.6e,%d,%d,%d\n', ...
      h.outerIteration(k),h.omega(1,k),h.omega(2,k),h.omega(min(3,size(h.omega,1)),k), ...
      h.N(k),h.multJ(k),h.trustUsed(k),h.trustNext(k),h.moveCeilingUsed(k),h.moveCeilingNext(k), ...
      h.trialCount(k),h.innerIterations(k),h.innerConverged(k),h.accepted(k),h.acceptanceRatio(k), ...
      h.predictedImprovement(k),h.actualImprovement(k),h.predictedSlope(k), ...
      h.densityChangeInf(k),h.densityChangeRms(k),h.volume(k),h.objective(k), ...
      h.relativeObjectiveChange(k),h.stationarityPass(k),h.convergenceCount(k), ...
      h.acceptedSinceMoveContraction(k),h.windowCumulativeProgress(k), ...
      h.windowMaxStepProgress(k),h.progressWindowReady(k),h.progressStationarityPass(k), ...
      h.moveCeilingContracted(k));
end
fclose(fid);

gray=4*mean(rho.*(1-rho));
fprintf(['AUDITRESULT tag=%s status=%s stop=%s outer=%d accepted=%d rejected=%d ' ...
  'inner=%d contractions=%d w1=%.6f w2=%.6f w3=%.6f N=%d trust=%.3e ceil=%.3e ' ...
  'dxInf=%.3e dxRms=%.3e relObj=%.3e slope=%.3e vol=%.8f gray=%.4f wall=%.1f\n'], ...
  tag,status,stop_reason,iterations.outer,iterations.accepted_updates, ...
  iterations.rejected_trials,iterations.inner_total,iterations.move_ceiling_contractions, ...
  omega(1),omega(2),omega(3),h.N(end),h.trustNext(end),h.moveCeilingNext(end), ...
  h.densityChangeInf(end),h.densityChangeRms(end),h.relativeObjectiveChange(end), ...
  h.predictedSlope(end),mean(rho),gray,wall);
end
