      },
      {
        "name": "case2",
        "factor": 0,
        "loads": {
          "type": "semi_harmonic",
          "mode": 2,
          "factor": 1
        }
      }
    ]
  },
  "material": {
    "model": "plane_stress_isotropic",
    "E": 1.0E+7,
    "nu": 0.3,
    "rho": 1
  },
  "void_material": {
    "E_min_ratio": 1E-6,
    "rho_min": 1E-6
  },
  "bc": {
    "supports": [
      {
        "type": "vertical_line",
        "x": 0,
        "dofs": [
          "ux",
          "uy"
        ],
        "tol": 1E-6
      },
      {
        "type": "vertical_line",
        "x": 8,
        "dofs": [
          "ux",
          "uy"
        ],
        "tol": 1E-6
      }
    ]
  },
  "optimization": {
    "approach": "ourApproach",
    "optimizer": "OC",
    "objective": "compliance",
    "interpolation": "SIMP",
    "volume_fraction": 0.5,
    "penalization": 3,
