    "move_limit": 0.2,
    "max_iters": 2000,
    "convergence_tol": 0.01,
    "seed": [],
    "harmonic_normalize": false,
    "load_case_weighting": "compliance",
    "stop_criterion": "stagnation_x",
    "stagnation": {
      "window": 10,
      "grayness_tol": 0.01,
      "relative_change_tol": 0.01
